<div class="border rounded bg-white p-4">

          <!-- 上段：タイトル + モード -->
          <div class="flex justify-between items-start">
            <div>
              <!-- タイトル -->
              <h2 class="font-semibold text-base text-gray-800">
                <%= challenge.title %>
              </h2>

              <!-- 作成者 -->
              <p class="text-xs text-gray-500 mt-1">
                作成者：<%= challenge.user.name %>
              </p>

            <% if challenge.multi? %>
              <p class="mt-1 text-sm text-gray-600">
                参加者: <%= challenge.participations.size %> / <%= challenge.capacity %>
              </p>
            <% end %>

          <!-- 日時 -->
          <div class="mt-2 text-sm text-gray-700 space-y-1">
            <div>
              目標時刻：
              📅 <%= challenge.target_date %>
              ⏰ <%= challenge.target_time.strftime("%H:%M") %>
            </div>

            <% if challenge.target_date.present? %>
              <% days_left = (challenge.target_date - Date.current).to_i %>
              <p class="text-xs text-gray-500">
                起床日まで残り
                <span class="font-semibold text-gray-700">
                  <%= if days_left.positive?
                        "#{days_left}日"
                      elsif days_left.zero?
                        "当日"
                      else
                        "終了"
                      end %>
                </span>
              </p>
            <% end %>
          </div>

            </div>

            <div class="flex flex-col items-end gap-1">
              <span class="inline-flex items-center text-xs px-2 py-1 rounded
                <%= challenge.solo? ? 'bg-gray-200 text-gray-800' : 'bg-orange-100 text-orange-800' %>">
                <%= challenge.solo? ? "ソロ" : "マルチ" %>
              </span>

              <% if challenge.success? %>
                <span class="inline-flex items-center px-2 py-0.5 text-xs font-semibold text-green-700 bg-green-100 rounded">
                  成功
                </span>
              <% elsif challenge.failed? %>
                <span class="inline-flex items-center px-2 py-0.5 text-xs font-semibold text-red-700 bg-red-100 rounded">
                  失敗
                </span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 text-xs font-semibold text-gray-600 bg-gray-100 rounded">
                  進行中
                </span>
              <% end %>
            </div>
          </div>

          <!-- 操作（詳細 / 削除） -->
          <div class="mt-4 flex items-center justify-end gap-4">
            <%= link_to "詳細を見る",
                  challenge_path(challenge),
                  class: "text-sm font-medium text-orange-600 hover:underline" %>

            <% if challenge.user_id == current_user.id && challenge.destroyable? %>
              <%= link_to "チャレンジを削除する",
                    challenge_path(challenge),
                    data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
                    class: "text-sm font-medium text-red-600 hover:underline" %>
            <% end %>
          </div>
        </div>