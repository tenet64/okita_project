<div class="min-h-screen flex flex-col items-center bg-gray-50">

  <div class="w-full max-w-lg bg-white px-10 py-10 mt-10 shadow-md rounded">

    <h1 class="text-center text-3xl font-semibold mb-8">ログイン</h1>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name),  data: { turbo: false}, html: { class: "space-y-6" }) do |f| %>

      <div>
        <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "mt-1 w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 px-3 py-2" %>
      </div>

      <div>
        <%= f.label :password, "パスワード", class: "block text-sm font-medium text-gray-700" %>
        <%= f.password_field :password, autocomplete: "current-password",
            class: "mt-1 w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 px-3 py-2" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2">
          <%= f.check_box :remember_me, class: "h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" %>
          <%= f.label :remember_me, class: "text-sm text-gray-700" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "ログイン", class: "w-full py-3 bg-gray-800 text-white rounded-md hover:bg-gray-900 transition" %>
      </div>

      <div class="text-right">
        <%= link_to "パスワードをお忘れですか？", new_user_password_path, class: "text-blue-600 text-sm hover:underline" %>
      </div>

    <% end %>

    <div class="relative mt-8">
      <div class="absolute inset-0 flex items-center">
        <div class="w-full border-t border-gray-300"></div>
      </div>
      <div class="relative flex justify-center text-sm">
        <span class="px-2 bg-white text-gray-500">または</span>
      </div>
    </div>

    <div class="mt-6">
      <p class="text-center text-sm text-gray-600 mb-3">アカウントをお持ちでないですか？</p>
      <%= link_to "新規登録", new_user_registration_path,
          class: "w-full block text-center bg-white border border-blue-600 text-blue-600 py-3 rounded-md hover:bg-blue-50 transition font-medium" %>
    </div>

  </div>
</div>