<div class="mb-8 bg-white p-6 rounded-lg shadow">
   <h1 class="text-xl font-bold mb-6 text-center">📈1週間の起床時間グラフ</h1>

  <div class="flex justify-between items-center mb-6 bg-gray-50 p-3 rounded-lg">
  <%= link_to graph_mypage_path(start_date: @start_date - 7.days), class: "flex items-center gap-1 text-gray-600 hover:text-orange-600 transition" do %>
    <span>&larr;</span> 前の週
  <% end %>

  <div class="font-bold text-lg text-gray-700">
    <%= @start_date.strftime("%-m/%-d") %> 
    <span class="text-gray-400 mx-1">〜</span> 
    <%= (@start_date + 6.days).strftime("%-m/%-d") %>
  </div>

  <%= link_to graph_mypage_path(start_date: @start_date + 7.days), class: "flex items-center gap-1 text-gray-600 hover:text-orange-600 transition" do %>
    次の週 <span>&rarr;</span>
  <% end %>
</div>

  <%= column_chart @chart_data,
      # 縦軸の設定：時間単位 (4時〜10時)
      min: 4, 
      max: 10,
      suffix: "時",
      ytitle: "時間",
      xtitle: "日付",
      colors: ["#ea580c"],
      height: "300px",
      library: { 
        plugins: { tooltip: { enabled: false } },
          scales: {
            y: {
              ticks: {
                stepSize: 1 # 「時間」ごとに目盛りを打つ
              }
            }
          }
        }
  %>
  
  <p class="text-xs text-gray-400 mt-2 text-right">
    ※ 縦軸は 4:00 〜 10:00 の範囲で表示しています
  </p>
</div>