<% case state %>
<% when :success %>
  <% challenge.participations.each do |p| %>
    <%= render "challenges/action_area/status", participation: p %>
  <% end %>

  <div class="mb-4 p-6 rounded-xl bg-gradient-to-r from-yellow-100 to-orange-100 border-2 border-orange-200 shadow-sm text-center">
    <div class="text-4xl mb-2 animate-bounce">
      🏆
    </div>
    <h3 class="text-xl font-bold text-orange-800 mb-1">
      おめでとうございます!!
    </h3>
    <p class="text-sm text-orange-700 font-medium">
      素晴らしい！チャレンジ達成です🎉<br>
      最高の1日になりますように！
    </p>
  </div>

<% when :failed %>
  <div class="mb-4 p-6 rounded-xl bg-slate-50 border border-slate-200 text-center">
    <div class="text-4xl mb-2 opacity-80">
      ☕️
    </div>
    <h3 class="text-lg font-bold text-slate-700 mb-1">
      惜しい！
    </h3>
    <p class="text-sm text-slate-500">
      今回は残念...でも大丈夫。<br>
      しっかりと休んで、また明日トライしましょう！
    </p>
  </div>



<% end %>