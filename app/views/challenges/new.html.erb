<div class="max-w-md mx-auto mt-10 bg-white p-6 rounded-lg shadow">
  <h1 class="text-xl font-bold mb-6 text-gray-800">
    チャレンジを作成
  </h1>

  <%= form_with model: @challenge, local: true do |f| %>

    <% if @challenge.errors.any? %>
      <div class="mb-4 text-sm text-red-600">
        <ul>
          <% @challenge.errors.full_messages.each do |msg| %>
            <li>• <%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :title, "チャレンジ名", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :title, placeholder: "例）7時起きチャレンジ",
            class: "w-full rounded border text-sm border-gray-300 focus:border-orange-400 focus:ring-orange-400" %>
    </div>

    <div class="mb-4">
      <%= f.label :description, "説明", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, placeholder: "意気込みなどあればこちらに！",
            rows: 4,
            class: "w-full rounded border border-gray-300 text-sm focus:border-orange-400 focus:ring-orange-400" %>
    </div>

    <div data-controller="mode-capacity">
      <div class="mb-4">
        <%= f.label :mode, "モード", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :mode,
              [["ソロ", "solo"], ["マルチ", "multi"]],
              {},
              class: "w-full rounded border border-gray-300 focus:border-orange-400 focus:ring-orange-400",
              data: { "mode-capacity-target": "mode" } %>
      </div>

      <div class="mb-6" data-mode-capacity-target="capacityWrap">
        <%= f.label :capacity, "メンバー（マルチのみ）", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :capacity,
              min: 2,
              class: "w-full rounded border border-gray-300 focus:border-orange-400 focus:ring-orange-400",
              data: { "mode-capacity-target": "capacity" } %>
      </div>
    </div>

    <div class="mb-4" data-controller="datetime-min">
      <%= f.label :target_date, "起床日", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.date_field :target_date,
            min: Date.current,
            class: "w-full rounded border border-gray-300 focus:border-orange-400 focus:ring-orange-400",
            data: { "datetime-min-target": "date" } %>

      <div class="mt-4">
        <%= f.label :target_time, "起床時間", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.time_field :target_time,
              class: "w-full rounded border border-gray-300 focus:border-orange-400 focus:ring-orange-400",
              data: { "datetime-min-target": "time" } %>
        <p class="mt-1 text-xs text-gray-500">※ 起床日が今日の場合、現在時刻より前の時間は選択できません</p>
      </div>
    </div>

    <%= f.submit "チャレンジを作成",
          class: "w-full bg-orange-500 text-white py-2 rounded hover:bg-orange-600" %>

  <% end %>
</div>