<header class="bg-[#FDEBD0] border-b border-gray-200" data-controller="mobile-menu">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">

    <%# --- PC用ナビゲーション (左側: ロゴ + メニュー) --- %>
    <div class="flex items-center space-x-6">
      <%# 1. ロゴ %>
      <%= link_to authenticated_root_path, class: "flex items-center space-x-2" do %>
        <%= image_tag "logo.svg", class: "h-8 w-8 object-contain", alt: "okita ロゴ" %>
        <span class="text-xl font-bold text-gray-800">okita!!</span>
      <% end %>

      <%# PC用メニュー項目 %>
      <nav class="hidden md:flex items-center space-x-4 text-sm font-medium text-orange-600">
        <%= link_to "使い方", how_to_use_path, class: "hover:text-orange-800 transition" %>
        <%= link_to "チャレンジを作成", new_challenge_path, class: "hover:text-orange-800 transition" %>
        <%= link_to "チャレンジ一覧", challenges_path, class: "hover:text-orange-800 transition" %>
        <%= link_to "ホーム", dashboard_path, class: "hover:text-orange-800 transition" %>
        <%= link_to "マイカレンダー", calendar_mypage_path, id: "pc-mypage-link", class: "hover:text-orange-800 transition" %>
        <%= link_to "週間グラフ", graph_mypage_path, class: "hover:text-orange-800 transition" %>
      </nav>
    </div>

    <%# --- PC用ユーザーメニュー (右側: ユーザー名ドロップダウン) --- %>
    <div class="hidden md:block">
      <%= link_to "マイページ", mypage_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-orange-50" %>
      <div class="border-t border-gray-100"></div>    
    </div>

    <%# --- スマホ用ハンバーガーボタン --- %>
    <%# justify-betweenが効くように、ここをPCメニューと同じ階層に置きました %>
    <div class="md:hidden flex items-center ml-auto">
      <button type="button" data-action="click->mobile-menu#toggle" class="text-gray-700 hover:text-orange-600 focus:outline-none p-2">
        <span class="sr-only">メニューを開く</span>
        <svg data-mobile-menu-target="openIcon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg data-mobile-menu-target="closeIcon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>

  <%# --- スマホ用メニュー本体 (全項目を展開して表示) --- %>
  <div data-mobile-menu-target="menu" class="hidden md:hidden border-t border-orange-200 bg-[#FFF5E6]">
    <nav class="flex flex-col p-4 space-y-3">
      <%# ユーザー情報 %>
      <% if user_signed_in? %>
      <div class="pb-2 border-b border-orange-200 mb-2">
        <p class="text-sm text-gray-500">ログイン中</p>
        <p class="font-bold text-gray-800"><%= current_user&.name %></p>
      </div>
      <% end %>

      <%= link_to "使い方", how_to_use_path, class: "block text-gray-700 font-medium py-1", data: { action: "click->mobile-menu#close" } %>
      <%= link_to "チャレンジを作成", new_challenge_path, class: "block text-gray-700 font-medium py-1", data: { action: "click->mobile-menu#close" } %>
      <%= link_to "チャレンジ一覧", challenges_path, class: "block text-gray-700 font-medium py-1", data: { action: "click->mobile-menu#close" } %>
      <%= link_to "マイカレンダー", calendar_mypage_path, class: "block text-gray-700 text-sm", data: { action: "click->mobile-menu#close" } %>
      <%= link_to "週間グラフ", graph_mypage_path, class: "block text-gray-700 text-sm", data: { action: "click->mobile-menu#close" } %>

      <div class="border-t border-orange-200 my-2"></div>

      <%= link_to "マイページ", mypage_path, class: "block text-gray-700", data: { action: "click->mobile-menu#close" } %>
      <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "block text-red-600 font-bold" %>
    </nav>
  </div>
</header>