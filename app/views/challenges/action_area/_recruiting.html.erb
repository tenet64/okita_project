<%# locals: challenge, state %>
<div class="space-y-3">
  <%# 募集中でも起床時刻までの残り時間を表示（参加可/参加中/満員いずれでも表示） %>
  <% if challenge.target_at.present? && Time.current < challenge.target_at %>
    <div class="text-center">
      <p class="text-sm font-medium text-gray-700">
        ⏳ 起床時間まで残り
      </p>

      <div
        class="mt-3 flex justify-center gap-4"
        data-controller="countdown"
        data-countdown-target-at-value="<%= challenge.target_at.iso8601 %>"
      >
        <div class="text-center">
          <div data-countdown-target="days" class="text-2xl font-bold">00</div>
          <div class="text-xs text-gray-500">日</div>
        </div>
        <div class="text-center">
          <div data-countdown-target="hours" class="text-2xl font-bold">00</div>
          <div class="text-xs text-gray-500">時間</div>
        </div>
        <div class="text-center">
          <div data-countdown-target="minutes" class="text-2xl font-bold">00</div>
          <div class="text-xs text-gray-500">分</div>
        </div>
        <div class="text-center">
          <div data-countdown-target="seconds" class="text-2xl font-bold">00</div>
          <div class="text-xs text-gray-500">秒</div>
        </div>
      </div>
    </div>
  <% end %>

  <% case state %>
  <% when :recruiting_can_join %>
    <%= link_to "このチャレンジに参加する",
          challenge_participations_path(challenge),
          data: { turbo_method: :post },
          class: "block w-full text-center bg-orange-500 text-white py-2 rounded hover:bg-orange-600" %>

  <% when :recruiting_joined %>
    <p class="text-sm text-green-600 text-center font-medium">
      ✔ 参加中です。メンバーが揃うまでお待ちください。
    </p>

  <% when :recruiting_full %>
    <p class="text-sm text-red-500 text-center">
      定員に達しています
    </p>
  <% end %>
</div>