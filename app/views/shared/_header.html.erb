<%# --- 共通のメニュー項目をここで定義 --- %>
<% menu_items = [
  { name: "チャレンジ一覧", path: challenges_path },
  { name: "マイチャレンジ", path: dashboard_path },
  { name: "マイページ", path: mypage_path }
] %>

<header class="bg-[#FDEBD0] border-b border-gray-200" data-controller="mobile-menu">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">

    <%# ロゴ部分 %>
    <%= link_to authenticated_root_path, class: "flex items-center space-x-2" do %>
      <%= image_tag "logo.svg", class: "h-8 w-8 object-contain", alt: "okita ロゴ" %>
      <span class="text-xl font-bold text-gray-800">okita!!</span>
    <% end %>

    <%# --- PC用ナビゲーション --- %>
    <nav class="hidden md:flex items-center space-x-6 text-sm font-medium text-orange-600">
      <% menu_items.each do |item| %>
        <%= link_to item[:name], item[:path], class: "hover:underline" %>
      <% end %>
      
      <%# PC用ドロップダウン（ユーザー名など） %>
      <div class="relative ml-4" data-controller="dropdown" data-action="click@window->dropdown#close">
        <button type="button" class="flex items-center space-x-2 focus:outline-none" data-action="click->dropdown#toggle">
          <span class="text-sm font-medium text-gray-700"><%= current_user&.name %> ▼</span>
        </button>
        <div data-dropdown-target="menu" class="hidden absolute right-0 top-8 w-48 rounded-md bg-white shadow-lg border border-gray-100 z-50 overflow-hidden">
          <%= link_to "プロフィール", profile_path, class: "block px-4 py-2 text-sm hover:bg-orange-50 text-gray-700" %>
          <div class="border-t"></div>

          <%= button_to "ログアウト", logout_path, method: :delete, data: { turbo: false }, class: "w-full text-left block px-4 py-2 text-sm text-red-600 hover:bg-red-50 bg-transparent border-0 cursor-pointer" %>
        </div>
      </div>
    </nav>

    <%# --- スマホ用ハンバーガーボタン --- %>
    <div class="md:hidden flex items-center">
      <button type="button" data-action="click->mobile-menu#toggle" class="text-gray-700 hover:text-orange-600 focus:outline-none p-2">
        <span class="sr-only">メニューを開く</span>
        <svg data-mobile-menu-target="openIcon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg data-mobile-menu-target="closeIcon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>

  <%# --- スマホ用メニュー本体 --- %>
  <div data-mobile-menu-target="menu" class="hidden md:hidden border-t border-orange-200 bg-[#FFF5E6]">
    <nav class="flex flex-col p-4 space-y-3">
      
      <%# 定義した配列をループして表示 %>
      <% menu_items.each do |item| %>
        <%= link_to item[:name], item[:path], 
            class: "block text-gray-700 font-medium", 
            data: { action: "click->mobile-menu#close" } %>
      <% end %>
      
      <div class="border-t border-orange-200 my-2"></div>
      
      <div class="flex items-center justify-between">
        <span class="text-sm text-gray-500">ログイン中: <%= current_user&.name %></span>
      </div>
      <%= link_to "プロフィール設定", profile_path, class: "block text-gray-700", data: { action: "click->mobile-menu#close" } %>

      <%= button_to "ログアウト", logout_path, method: :delete, data: { turbo: false }, class: "w-full text-left block text-red-600 font-bold bg-transparent border-0 cursor-pointer" %>
    </nav>
  </div>
</header>
