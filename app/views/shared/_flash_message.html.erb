<% flash.each do |type, message| %>
  <%
    base_classes = "w-full border-b border-t px-4 py-3"
    color_classes =
      case type.to_sym
      when :notice then "bg-blue-50 text-blue-700 border-blue-200"
      when :alert  then "bg-red-50 text-red-700 border-red-200"
      else "bg-gray-50 text-gray-700 border-gray-200"
      end
  %>

  <div class="<%= base_classes %> <%= color_classes %>">
    <p class="text-sm font-bold text-center">
      <%= message %>
    </p>
  </div>
<% end %>