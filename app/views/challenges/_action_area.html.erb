<%= turbo_frame_tag "action_area_challenge_#{challenge.id}" do %>
  <section class="pt-4 border-t space-y-3">
    <% state = challenge.action_state_for(current_user) %>

    <% case state %>
    <% when :recruiting_joined, :recruiting_can_join, :recruiting_full %>
      <%= render "challenges/action_area/recruiting", challenge: challenge, state: state %>

    <% when :ready_waiting, :recruiting_waiting %>
      <%= render "challenges/action_area/waiting", challenge: challenge %>

    <% when :ready_missed, :ready_done, :ready_can_wake, :ready_no_permission %>
      <%= render "challenges/action_area/wakeup", challenge: challenge, state: state %>


    <%= turbo_stream_from challenge %>
    <div class="space-y-2">
      <% challenge.participations.each do |p| %>
        <div id="participation_<%= p.id %>">
          <%= render "challenges/action_area/status", participation: p %>
        </div>
      <% end %>
    </div>  

    <% when :success, :failed %>
      <%= render "challenges/action_area/result", state: state , challenge: challenge %>
    <% end %>
  </section>
<% end %>