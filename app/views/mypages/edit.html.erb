<div class="min-h-screen bg-gray-50 py-10 px-4">
  <div class="max-w-md mx-auto bg-white rounded-2xl shadow-sm p-6">
    
    <h1 class="text-xl font-bold mb-6 text-gray-800">プロフィール編集</h1>

    <%= form_with model: @user, url: mypage_path, method: :patch, local: true do |form| %>

      <% if @user.errors.any? %>
        <div class="mb-4 text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-100">
          <ul class="list-disc list-inside">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-4">
        <%= form.label :name, "ユーザー名", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :name,
              class: "w-full rounded-lg border border-gray-300 focus:border-orange-400 focus:ring-orange-400" %>
      </div>

      <div class="mb-6">
        <%= form.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.email_field :email,
              class: "w-full rounded-lg border border-gray-300 focus:border-orange-400 focus:ring-orange-400" %>
      </div>

      <div class="mt-8 flex flex-col gap-3">
        <%# 更新ボタン %>
        <%= form.submit "プロフィールを更新する",
              class: "w-full cursor-pointer text-center px-4 py-2 rounded-lg bg-blue-600 text-white font-medium hover:bg-blue-700 transition" %>

        <%# 戻るボタン：blockクラスを追加して幅広に %>
        <%= link_to "マイページへ戻る",
              mypage_path,
              class: "block w-full text-center px-4 py-2 rounded-lg bg-gray-100 text-gray-700 font-medium hover:bg-gray-200 transition" %>
      </div>

    <% end %>
  </div>
</div>