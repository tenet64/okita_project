<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "okita!!" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= favicon_link_tag('favicon.ico') %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= display_meta_tags(default_meta_tags) %>
  </head>

  <body class="flex flex-col min-h-screen bg-fixed bg-cover bg-center" 
      style="background-image: url('<%= asset_path('background.png') %>');">

  <% if user_signed_in? %>
    <%= render 'shared/header' %>
  <% else %>
    <%= render 'shared/before_login_header' %>
  <% end %>

  <%= render 'shared/flash_message' %>

  <main class="flex-grow bg-white/70 backdrop-blur-[2px]">
    <%= yield %>
  </main>

  <%= render 'shared/footer' %>
</body>
</html>
